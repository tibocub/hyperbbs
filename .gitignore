node_modules
bun.lock


# Local graph data directories (RocksDB storage) — per-machine runtime
# state, not source. Created by --data= flags in main.js and host-site.js.
*-data/

# Claude Code local state (may contain machine-local permissions/session data).
# .claude/skills/ (the spec-kit workflow itself) stays tracked.
.claude/settings.local.json
.claude/.credentials.json

# Byproducts of spec-kit's Python-based tooling scripts (.specify/scripts/python/) —
# generated on every /speckit-* invocation, not something to commit.
__pycache__/
*.pyc
